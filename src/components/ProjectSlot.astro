---
// One project on the grid: a spinning disc sits on top of its cover.
// It's a plain link, so without JavaScript it opens the project directly.
// With JS (see the script in pages/index.astro), the first tap lifts the disc off to
// reveal the cover, and the second tap opens the project. The cover shares a
// view-transition name with the project page, so it glides into place there.
import CoverArt from './CoverArt.astro';
import Record from './Record.astro';
import { coverTransition, projectYear, type Project } from '../lib/projects';

interface Props {
	project: Project;
	/** Project number, e.g. "04" */
	no: string;
}

const { project, no } = Astro.props;
const { title, category, color, ink, spin } = project.data;
---

<a
	class="slot"
	href={`/projects/${project.id}`}
	data-slot={project.id}
	data-title={title}
	data-no={no}
	aria-label={`${title}, ${category}, ${projectYear(project)}`}
>
	<div class="sq">
		<div class="art" style={`view-transition-name: ${coverTransition(project)}`}>
			<CoverArt project={project} no={no} />
		</div>
		<div class="rec">
			<Record color={color} ink={ink} top={`NO. ${no}`} bottom={category.toUpperCase()} spin={spin} />
		</div>
	</div>
	<div class="cap">
		<span class="pre">No. {no} · tap to reveal</span>
		<span class="post">
			<span class="t">{title}</span>
			<span class="m">{category}</span>
		</span>
	</div>
</a>

<style>
	.slot {
		display: block;
		text-decoration: none;
		-webkit-tap-highlight-color: transparent;
	}

	.slot:focus-visible {
		outline: none;
	}

	.slot:focus-visible .sq {
		outline: 2px solid var(--ac);
		outline-offset: 5px;
	}

	.sq {
		position: relative;
		aspect-ratio: 1;
		border-radius: var(--radius-sleeve);
	}

	.art {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: var(--radius-sleeve);
		transform: scale(0.96);
		transition: transform var(--t-reveal) var(--ease);
	}

	.rec {
		position: absolute;
		inset: 0;
		transition:
			opacity 0.4s ease,
			transform var(--t-reveal) var(--ease);
	}

	/* Without JS there's nothing to reveal: show the cover and keep the disc off. */
	:global(html:not(.js)) .slot .rec {
		display: none;
	}

	:global(html:not(.js)) .slot .art,
	.slot.open .art {
		transform: none;
	}

	/* The disc lifts up and away rather than just fading. */
	.slot.open .rec {
		opacity: 0;
		transform: translate3d(0, -6%, 0) scale(1.08);
		pointer-events: none;
	}

	/* Never scale a spinning layer on hover; it blurs. Lift it instead. */
	@media (hover: hover) {
		.slot:not(.open):hover .rec {
			transform: translate3d(0, -4px, 0);
		}

		.slot.open:hover .art {
			transform: translate3d(0, -5px, 0);
		}
	}

	.cap {
		display: grid;
		margin-top: 14px;
		font-size: 14px;
	}

	.cap > * {
		grid-area: 1 / 1;
		transition: opacity 0.35s ease;
	}

	.pre {
		font: 12px var(--font-mono);
		color: var(--dim);
	}

	.post {
		opacity: 0;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8px;
		min-width: 0;
	}

	.t {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.m {
		font: 11px var(--font-mono);
		color: var(--mu);
		white-space: nowrap;
	}

	:global(html:not(.js)) .slot .post,
	.slot.open .post {
		opacity: 1;
	}

	:global(html:not(.js)) .slot .pre,
	.slot.open .pre {
		opacity: 0;
	}

	@media (max-width: 480px) {
		.cap {
			font-size: 13px;
		}

		.post {
			flex-direction: column;
			gap: 2px;
		}
	}

	/* Applied briefly on load so already-revealed slots don't replay the animation. */
	:global(.instant) .rec,
	:global(.instant) .art,
	:global(.instant) .cap > * {
		transition: none !important;
	}
</style>
