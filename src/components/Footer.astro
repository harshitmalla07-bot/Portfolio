---
import { site } from '../data/site';
import CopyEmail from './CopyEmail.astro';
---

<footer class="foot">
	<span>
		{site.name} · pressed in {new Date().getFullYear()}
	</span>
	<div class="links">
		{site.links.github && (
			<a href={site.links.github} target="_blank" rel="noopener">
				GitHub ↗
			</a>
		)}
		<a href={site.links.linkedin} target="_blank" rel="noopener">
			LinkedIn ↗
		</a>
		<CopyEmail />
	</div>
</footer>

<style>
	.foot {
		border-top: 1px solid var(--ln);
		padding-block: 22px calc(22px + env(safe-area-inset-bottom, 0px));
		padding-inline: max(var(--gut), calc((100% - var(--max)) / 2 + var(--gut)));
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 12px 24px;
		font-size: 13px;
		color: var(--mu);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 18px;
	}

	a {
		text-decoration: none;
		transition: color var(--t-fast);
	}

	a:hover {
		color: var(--tx);
	}
</style>
