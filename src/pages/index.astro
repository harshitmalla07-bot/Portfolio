---
// Discography (home). Design: docs/prototype.html → Discography view; rules: docs/DESIGN.md.
import Base from '../layouts/Base.astro';
import Record from '../components/Record.astro';
import ReleaseSlot from '../components/ReleaseSlot.astro';
import { getReleases, pad2, releaseYear } from '../lib/releases';
import { site } from '../data/site';

const releases = await getReleases();
const latest = releases[0];
// Only offer filters for release types that actually exist.
const types = (['LP', 'EP', 'Single'] as const).filter((t) => releases.some((r) => r.data.type === t));
---

<Base>
	<section class="hero">
		<div class="wrap hero-in">
			<p class="lab">
				{site.role} · catalog {site.catalogYears}
			</p>
			<h1 class="display">
				Selected works,
				<br />
				<em>pressed on wax.</em>
			</h1>
			<p class="intro">{site.intro}</p>
			<div class="hero-foot">
				{latest && (
					<a class="now" href={`/discography/${latest.id}`}>
						<span class="mini">
							<Record color={latest.data.color} ink={latest.data.ink} spin={2.2} />
						</span>
						Now spinning · {latest.data.title}
						<span class="mono dim">
							{latest.data.type}, {releaseYear(latest)}
						</span>
					</a>
				)}
				<p class="avail">
					<span class="dot" aria-hidden="true"></span>
					{site.availability}
				</p>
			</div>
		</div>
	</section>

	<section class="wrap sec" aria-labelledby="disco-title">
		<div class="sec-head">
			<h2 class="lab" id="disco-title">
				Discography · {pad2(releases.length)} releases
			</h2>
			<div class="chips" data-filters hidden>
				{['All', ...types].map((t) => (
					<button type="button" class="chip" data-filter={t} aria-pressed={t === 'All' ? 'true' : 'false'}>
						{t}
					</button>
				))}
				<button type="button" class="lnk" data-reset>
					Re-sleeve all
				</button>
			</div>
		</div>

		<ul class="grid" data-grid>
			{releases.map((r) => (
				<li data-type={r.data.type}>
					<ReleaseSlot release={r} />
				</li>
			))}
		</ul>
		<p class="hint" data-hint hidden>
			Tap a record to take it off. Tap the cover to open the release.
		</p>
	</section>
</Base>

<script>
	const KEY = 'revealed-releases';
	const load = (): Set<string> => {
		try {
			return new Set(JSON.parse(sessionStorage.getItem(KEY) ?? '[]'));
		} catch {
			return new Set();
		}
	};
	const save = (ids: Set<string>) => {
		try {
			sessionStorage.setItem(KEY, JSON.stringify([...ids]));
		} catch {
			/* storage blocked: reveals just won't persist */
		}
	};

	const grid = document.querySelector<HTMLElement>('[data-grid]');
	const filters = document.querySelector<HTMLElement>('[data-filters]');
	const revealed = load();

	const label = (slot: HTMLAnchorElement) => {
		const { title, cat } = slot.dataset;
		slot.setAttribute('aria-label', slot.classList.contains('open') ? `Open ${title}` : `${cat}: reveal release`);
	};

	if (grid) {
		const slots = [...grid.querySelectorAll<HTMLAnchorElement>('[data-slot]')];

		// Restore earlier reveals without replaying the animation.
		grid.classList.add('instant');
		for (const slot of slots) {
			slot.classList.toggle('open', revealed.has(slot.dataset.slot!));
			label(slot);
			slot.addEventListener('click', (e) => {
				if (slot.classList.contains('open')) return; // second tap: follow the link
				// Let Ctrl/Cmd/Shift-click and middle-click open the release in a new tab as usual.
				if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
				e.preventDefault();
				slot.classList.add('open');
				revealed.add(slot.dataset.slot!);
				save(revealed);
				label(slot);
			});
		}
		requestAnimationFrame(() => requestAnimationFrame(() => grid.classList.remove('instant')));

		document.querySelector('[data-hint]')?.removeAttribute('hidden');
	}

	if (grid && filters) {
		filters.removeAttribute('hidden');
		filters.addEventListener('click', (e) => {
			const target = e.target as HTMLElement;
			const chip = target.closest<HTMLButtonElement>('[data-filter]');
			if (chip) {
				const type = chip.dataset.filter;
				filters.querySelectorAll('[data-filter]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
				grid.querySelectorAll<HTMLElement>('li[data-type]').forEach((li) => {
					li.hidden = !(type === 'All' || li.dataset.type === type);
				});
				return;
			}
			if (target.closest('[data-reset]')) {
				revealed.clear();
				save(revealed);
				grid.querySelectorAll<HTMLAnchorElement>('[data-slot].open').forEach((slot) => {
					slot.classList.remove('open');
					label(slot);
				});
			}
		});
	}
</script>

<style>
	.hero {
		border-bottom: 1px solid var(--ln);
	}

	.hero-in {
		display: grid;
		gap: 20px;
		padding-block: clamp(48px, 9vw, 104px) clamp(36px, 6vw, 64px);
	}

	.hero-in .lab {
		margin: 0;
		color: var(--mu);
	}

	.intro {
		max-width: 52ch;
		margin: 0;
		color: var(--mu);
	}

	.hero-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 14px 24px;
	}

	.now {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		max-width: 100%;
		padding: 7px 14px 7px 8px;
		border: 1px solid var(--ln-2);
		border-radius: var(--radius-pill);
		font-size: 13px;
		text-decoration: none;
		transition: border-color var(--t-fast);
	}

	.now:hover {
		border-color: var(--ln-hover);
	}

	.mini {
		width: 22px;
		flex: none;
	}

	.dim {
		font-size: 11px;
		color: var(--dim);
	}

	.avail {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin: 0;
		font: 12px/1.5 var(--font-mono);
		color: var(--tx);
	}

	.dot {
		flex: none;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--ac);
	}

	.sec {
		padding-block: 32px 64px;
	}

	.sec-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 14px;
		margin-bottom: 26px;
	}

	.sec-head .lab {
		margin: 0;
	}

	.chips {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px;
	}

	.chips[hidden] {
		display: none;
	}

	.chip {
		font: 12px var(--font-mono);
		color: var(--mu);
		background: none;
		border: 1px solid var(--ln-2);
		border-radius: var(--radius-pill);
		padding: 5px 12px;
		cursor: pointer;
		transition:
			color var(--t-fast),
			background var(--t-fast),
			border-color var(--t-fast);
	}

	.chip:hover {
		color: var(--tx);
	}

	.chip[aria-pressed='true'] {
		color: var(--bg);
		background: var(--tx);
		border-color: var(--tx);
	}

	.chips .lnk {
		margin-left: 10px;
	}

	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 32px 26px;
	}

	.hint {
		margin: 36px 0 0;
		font: 12px var(--font-mono);
		color: var(--dim);
	}

	@media (max-width: 820px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 480px) {
		.grid {
			gap: 24px 14px;
		}
	}
</style>
