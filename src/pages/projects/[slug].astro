---
// Project page. Layout: docs/prototype.html; rules: docs/DESIGN.md.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Record from '../../components/Record.astro';
import CoverArt from '../../components/CoverArt.astro';
import { getProjects, coverTransition, projectNo, statusLine, timeline, type Project } from '../../lib/projects';

export const getStaticPaths = (async () => {
	const projects = await getProjects();
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: {
			project,
			no: projectNo(i, projects.length),
			position: i + 1,
			total: projects.length,
			prev: projects[(i - 1 + projects.length) % projects.length],
			next: projects[(i + 1) % projects.length],
		},
	}));
}) satisfies GetStaticPaths;

interface Props {
	project: Project;
	no: string;
	position: number;
	total: number;
	prev: Project;
	next: Project;
}

const { project, no, position, total, prev, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Photos render at a fixed height (max 440px) and keep their aspect ratio, so the
// displayed width is known per photo: request 1x and 2x of that, not a full-width image.
const PHOTO_MAX_H = 440;
const photoW = (img: ImageMetadata) => Math.round((PHOTO_MAX_H * img.width) / img.height);
const photoSize = (img: ImageMetadata) => `${photoW(img)}px`;
const photoWidths = (img: ImageMetadata) => [photoW(img), Math.min(img.width, photoW(img) * 2)];

const meta = [
	['Role', data.role],
	['Stack', data.stack.join(', ')],
	['Status', data.status],
	['Timeline', timeline(project)],
];
---

<Base title={data.title} description={data.tagline}>
	<article class="wrap rel">
		<div class="rel-top">
			<a class="lnk" href="/">
				← All projects
			</a>
			<span class="mono pos">
				No. {no} · {position} of {total}
			</span>
		</div>

		<div class="rel-grid">
			<div class="sleeve">
				<div class="out">
					<Record color={data.color} ink={data.ink} top={`NO. ${no}`} bottom={data.category.toUpperCase()} spin={7} />
				</div>
				<div class="jacket" style={`view-transition-name: ${coverTransition(project)}`}>
					<CoverArt project={project} no={no} />
				</div>
			</div>

			<div class="info">
				<p class="lab">
					{data.category} · {statusLine(project)}
				</p>
				<h1>{data.title}</h1>
				<p class="tag">{data.tagline}</p>

				{(data.links.source || data.links.journal || data.links.demo) && (
					<div class="actions">
						{data.links.source && (
							<a class="btn pri" href={data.links.source} target="_blank" rel="noopener">
								Source on GitHub ↗
							</a>
						)}
						{data.links.journal && (
							<a class="btn" href={data.links.journal} target="_blank" rel="noopener">
								Design journal ↗
							</a>
						)}
						{data.links.demo && (
							<a class="btn" href={data.links.demo} target="_blank" rel="noopener">
								Live demo ↗
							</a>
						)}
					</div>
				)}

				<dl class="meta">
					{meta.map(([k, v]) => (
						<div>
							<dt>{k}</dt>
							<dd>{v}</dd>
						</div>
					))}
				</dl>

				<h2 class="lab">Highlights</h2>
				<ol class="highlights">
					{data.highlights.map((t, i) => (
						<li>
							<span class="n">{String(i + 1).padStart(2, '0')}</span>
							<span>{t.title}</span>
							<span class="k">{t.kind}</span>
						</li>
					))}
				</ol>

				<h2 class="lab">Write-up</h2>
				<div class="writeup">
					<Content />
				</div>
			</div>
		</div>

		{data.photos.length > 0 && (
			<section class="gallery" aria-labelledby="photos-title">
				<h2 class="lab" id="photos-title">
					Photos
				</h2>
				<div class="photos">
					{data.photos.map((p) => (
						<figure>
							<Image src={p.src} alt={p.alt} widths={photoWidths(p.src)} sizes={photoSize(p.src)} />
							{p.caption && <figcaption>{p.caption}</figcaption>}
						</figure>
					))}
				</div>
			</section>
		)}

		<nav class="pn" aria-label="More projects">
			<a href={`/projects/${prev.id}`}>
				<span class="lab">← Previous</span>
				<span class="pt">{prev.data.title}</span>
			</a>
			<a class="nx" href={`/projects/${next.id}`}>
				<span class="lab">Next →</span>
				<span class="pt">{next.data.title}</span>
			</a>
		</nav>
	</article>
</Base>

<style>
	.rel {
		padding-block: 28px 64px;
	}

	.rel-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 12px;
		margin-bottom: 40px;
	}

	.pos {
		font-size: 11px;
		color: var(--dim);
	}

	.rel-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: 64px;
		align-items: start;
	}

	/* Sleeve with the record half out to the right, still spinning. */
	.sleeve {
		position: relative;
		width: 72%;
		aspect-ratio: 1;
	}

	.out {
		position: absolute;
		left: 32%;
		top: 3%;
		width: 94%;
		animation: pull 1.15s 0.12s var(--ease) both;
	}

	.jacket {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: var(--radius-sleeve);
		box-shadow: 14px 0 34px rgb(0 0 0 / 0.6);
	}

	@keyframes pull {
		from {
			transform: translateX(-34%);
		}
	}

	.info {
		min-width: 0;
		animation: rise 0.65s 0.08s var(--ease) both;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}

	.info > .lab:first-child {
		margin: 0;
	}

	h1 {
		font: 400 clamp(46px, 7vw, 84px) / 0.98 var(--font-display);
		letter-spacing: -0.025em;
		margin: 4px 0 14px;
	}

	.tag {
		max-width: 46ch;
		margin: 0 0 24px;
		color: var(--mu);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 30px;
	}

	.meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px 20px;
		margin: 0 0 30px;
		padding: 16px 0;
		border-block: 1px solid var(--ln);
	}

	.meta div {
		min-width: 0;
	}

	.meta dt {
		font: 11px var(--font-mono);
		color: var(--dim);
		letter-spacing: 0.07em;
		text-transform: uppercase;
		margin-bottom: 4px;
	}

	.meta dd {
		margin: 0;
		font-size: 14px;
	}

	.highlights {
		list-style: none;
		margin: 0 0 30px;
		padding: 0;
	}

	.highlights li {
		display: grid;
		grid-template-columns: 34px minmax(0, 1fr) auto;
		gap: 8px;
		align-items: baseline;
		padding: 11px 0;
		border-top: 1px solid var(--ln);
		font-size: 14px;
		transition: color var(--t-fast);
	}

	.highlights li:last-child {
		border-bottom: 1px solid var(--ln);
	}

	.highlights li:hover {
		color: var(--ac);
	}

	.n,
	.k {
		font: 12px var(--font-mono);
		color: var(--dim);
	}

	.k {
		font-size: 11px;
		text-align: right;
	}

	.writeup :global(p) {
		max-width: 62ch;
		margin: 0 0 14px;
		color: var(--body-2);
		line-height: 1.7;
	}

	.writeup :global(code) {
		font: 0.9em var(--font-mono);
		color: var(--tx);
		background: var(--raise);
		border: 1px solid var(--ln);
		border-radius: 4px;
		padding: 1px 5px;
	}

	.gallery {
		margin-top: 56px;
	}

	/* Photos keep their own shape at a shared height; they swipe sideways when they overflow. */
	.photos {
		display: flex;
		gap: 14px;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
		padding-bottom: 6px;
	}

	figure {
		flex: none;
		margin: 0;
		scroll-snap-align: start;
	}

	figure img {
		height: clamp(260px, 42vw, 440px);
		width: auto;
		max-width: none;
		border-radius: 4px;
		border: 1px solid var(--ln);
		background: var(--shot);
	}

	figcaption {
		max-width: 46ch;
		margin-top: 10px;
		font: 12px/1.5 var(--font-mono);
		color: var(--dim);
	}

	.pn {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 12px;
		margin-top: 56px;
		padding-top: 20px;
		border-top: 1px solid var(--ln);
	}

	.pn a {
		display: grid;
		gap: 4px;
		padding: 6px 0;
		text-decoration: none;
	}

	.pn .lab {
		margin: 0;
	}

	.pt {
		font: 400 26px/1.1 var(--font-display);
		transition: color var(--t-fast);
	}

	.pn a:hover .pt {
		color: var(--ac);
	}

	.nx {
		text-align: right;
	}

	@media (max-width: 760px) {
		.rel-top {
			margin-bottom: 28px;
		}

		.rel-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: 36px;
		}

		.sleeve {
			width: 64%;
		}
	}

	@media (max-width: 480px) {
		.actions .btn {
			flex: 1;
		}

		.photos {
			margin-inline: calc(var(--gut) * -1);
			padding-inline: var(--gut);
			scroll-padding-inline: var(--gut);
		}

		.pt {
			font-size: 22px;
		}
	}
</style>
