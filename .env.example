# Copy this file to .env and fill in values. Never commit .env.
# These power the "Email it to me" resume form (Phase 5). The site builds without them.

# https://resend.com → API Keys
RESEND_API_KEY=

# Sender address on a domain you've verified in Resend, e.g. "Harshit <resume@yourname.dev>"
RESUME_FROM_EMAIL=

# Where to send a copy of each request, so you know who asked for your resume
RESUME_NOTIFY_EMAIL=

# https://dash.cloudflare.com → Turnstile. Use Cloudflare's test keys for local dev.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
